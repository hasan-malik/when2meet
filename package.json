{
  "name": "pickatime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "npm run check && vite build",
    "deploy": "netlify deploy --build --prod",
    "check": "esbuild scripts/render-check.jsx --bundle --packages=external --platform=node --format=esm --jsx=automatic --outfile=node_modules/.render-check.mjs --log-level=error && node node_modules/.render-check.mjs",
    "layout:save": "node scripts/layout-baseline.mjs save",
    "layout:check": "node scripts/layout-baseline.mjs check"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "netlify-cli": "^17.38.1",
    "vite": "^5.4.8"
  }
}
